{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualor.dev/schema/qualor-rules/rule-metadata.json",
  "title": "The metadata of a Qualor security rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "cwe", "owasp", "kind", "severity", "confidence", "frameworks", "sources", "since"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\n]+$" },
    "cwe": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^CWE-[1-9][0-9]{0,6}$" }
    },
    "owasp": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^A(0[1-9]|10):20[0-9]{2}$" }
    },
    "kind": { "enum": ["issue", "hotspot"] },
    "severity": { "enum": ["blocker", "high", "medium", "low", "info"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*$" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https://[^\\s]+$" }
    },
    "since": { "type": "string", "pattern": "^[0-9]{4}\\.([1-9]|1[0-2])\\.(0|[1-9][0-9]*)$" }
  }
}
