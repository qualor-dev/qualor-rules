@model ProfileModel
@{
    ViewData["Title"] = "Profile";
}
<h1>@Model.Name</h1>
<section class="bio">
    @* ruleid: csharp.xss *@
    @Html.Raw(Model.Bio)
</section>
<p>
    @* ok: csharp.xss *@
    @Model.Bio
</p>
<form asp-action="Show" method="get">
    @* ok: csharp.xss *@
    <input name="q" value="@Model.Bio" />
</form>
